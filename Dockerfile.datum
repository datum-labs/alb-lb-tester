# Image for Datum Compute, built with `datumctl compute build` (see the
# compute-image workflow). Datum Compute runs unikernels: it boots the final
# stage's filesystem from RAM under its own kernel, so the entrypoint has to be
# an x86_64 binary with its loader and shared libraries in that stage, and with
# no WORKDIR the command runs as written rather than through a shell.

# Base images are pinned by digest so a rebuild gets the same bytes; to update
# one, look up the tag's current digest and replace it here.
FROM node:26-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072 AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_OUTPUT=standalone NEXT_TELEMETRY_DISABLED=1
RUN npm run build
# The standalone server plus the static assets it serves itself.
RUN mkdir -p /out/app \
  && cp -r .next/standalone/. /out/app/ \
  && cp -r .next/static /out/app/.next/static \
  && cp raw-headers.cjs /out/app/raw-headers.cjs \
  && if [ -d public ]; then cp -r public /out/app/public; fi

# Node plus the shared libraries it links against, and nothing else: no shell,
# no package manager, a small root filesystem to hold in RAM.
FROM gcr.io/distroless/nodejs26-debian13@sha256:e2a8b92ece0f4447203399a40bd1abc12547052b32e004cf0a28002c1cd12be3
COPY --from=build /out/app /app
# Next's standalone server listens on $HOSTNAME. Compute instances get IPv6
# addresses only, so bind "::" (every interface, IPv6 and IPv4); "0.0.0.0" is
# IPv4 only and leaves the edge's connections refused.
# raw-headers.cjs records request headers before Next fills in X-Forwarded-*,
# so the origin echo reports what the proxy actually sent.
ENV NODE_ENV=production PORT=3000 HOSTNAME=:: NODE_OPTIONS="--require /app/raw-headers.cjs"
EXPOSE 3000
WORKDIR /
# server.js changes into its own directory before it loads the app.
CMD ["/app/server.js"]
